<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="14dp"
        android:paddingEnd="15dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/widget_art_background"
                android:clipToOutline="true"
                android:contentDescription="@string/widget_artwork_desc"
                android:scaleType="centerCrop"
                tools:targetApi="s" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_notification"
                        android:tint="#F4F4F5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:letterSpacing="0.08"
                        android:text="KURO STUDIO"
                        android:textColor="#E4E4E7"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_placeholder_title"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_placeholder_artist"
                    android:textColor="#B8B8C0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#38FFFFFF"
            android:progressTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_favorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_chip_background"
                android:contentDescription="@string/widget_favorite_desc"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_heart_outline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_chip_background"
                android:contentDescription="@string/widget_previous_desc"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_kuro_rewind"
                android:tint="#F4F4F5" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/widget_play_desc"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_kuro_play"
                android:tint="#09090B" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_chip_background"
                android:contentDescription="@string/widget_next_desc"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_kuro_fast_forward"
                android:tint="#F4F4F5" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
